{
  "compilerOptions": {
    "target": "ES2020", // JS đầu ra
    "module": "ES2020", // dùng import/export
    "moduleResolution": "bundler",
    "lib": ["ES2020", "DOM"], // có document, HTMLInputElement...
    "strict": true, // kiểm tra chặt
    "rootDir": "./src", // code TS ở đây
    "outDir": "./dist" // JS sau compile ở đây
  },
  "include": ["src"]
}
